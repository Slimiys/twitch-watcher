    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@types/node": "^24.10.1",
    "@types/node-notifier": "^8.0.5",
    "@types/ws": "^8.5.13",
    "husky": "^8.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
