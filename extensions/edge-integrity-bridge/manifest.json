{
  "manifest_version": 3,
  "name": "Twitch Watcher — Integrity Bridge",
  "version": "1.2.0",
  "description": "Client-Integrity для Twitch Watcher и уведомления stream-up/stream-down",
  "permissions": ["storage", "webRequest", "tabs", "alarms", "notifications", "offscreen"],
  "icons": {
    "128": "icon128.png"
  },
  "host_permissions": [
    "https://gql.twitch.tv/*",
    "https://*.twitch.tv/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://127.0.0.1/*",
    "https://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-stream-notifications": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Включить или выключить уведомления о стримах"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "http://0.0.0.0/*",
        "https://127.0.0.1/*",
        "https://localhost/*"
      ],
      "js": ["dashboard-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Twitch Watcher Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon128.png"
    }
  }
}
