# Режим работы: api или puppeteer (по умолчанию puppeteer)
MODE=api

# Уровень логирования: verbose, normal, minimal (по умолчанию normal)
LOG_LEVEL=normal

# Логи в файлы (два файла по 100 МБ, затем очистка первого и цикл)
# LOG_TO_FILE=false — отключить
LOG_DIR=./logs
LOG_FILE_MAX_MB=100
LOG_FILE_BASENAME=twitch-watcher
# LOG_CLEAR_ON_START=false — не удалять старые .1.log / .2.log при старте

# Максимальное количество одновременно просматриваемых каналов (только для API режима)
MAX_SIMULTANEOUS_CHANNELS=2

# Health Check настройки
HEALTH_CHECK_PORT=3000

# Web Server настройки
WEB_SERVER_PORT=3001
# WEB_DASHBOARD_API_KEY=your_secret_key — защита REST /api/* (кроме server-info и initialization-status)
# Ключ передаётся в заголовке X-API-Key или Authorization: Bearer из настроек dashboard

# API-режим: minute-watched и бонусы
# WATCH_PREP_INTERVAL_MS=300000 — полное обновление стримера перед watch (мс, по умолчанию 5 мин)
# WATCH_OPERATION_TIMEOUT_MS=10000 — таймаут одной операции watch/spade (мс)
# WATCH_MODE=per-channel — таймер minute-watched на каждый онлайн-канал (batch = общий цикл)
# WATCH_ALL_ONLINE_CHANNELS=true — в batch-режиме: все онлайн (false = ротация MAX_SIMULTANEOUS_CHANNELS)
# WATCH_CYCLE_INTERVAL_MS=60000 — интервал между отправками (per-channel: после завершения тика)
# CLAIM_CHECK_INTERVAL_MS=120000 — опрос GraphQL на availableClaim (мс)
# WATCH_RESUME_MAX_AGE_MS=86400000 — макс. возраст сохранённого состояния для возобновления просмотра (мс, по умолчанию 24 ч)
# WEB_SERVER_START_MAX_ATTEMPTS=12 — попыток при старте, если порт занят
# WEB_SERVER_START_RETRY_DELAY_MS=5000 — пауза между попытками при старте (мс)
# WEB_SERVER_BACKGROUND_RETRY_DELAY_MS=30000 — пауза фонового retry dashboard (мс)
# WEB_SERVER_HTTPS=true — дашборд по HTTPS (уведомления ОС в браузере по IP)
# SSL_DIR=./certs
# SSL_CERT_PATH=./certs/server.crt
# SSL_KEY_PATH=./certs/server.key
# SSL_EXTRA_SANS=192.168.1.145 — IP/имена для сертификата (через запятую)
# SSL_CERT_CN=twitch-watcher

# Авто-завершение процесса (по умолчанию только в Docker, на Termux — выключено)
# AUTO_EXIT_ON_UNHEALTHY=true  — принудительно завершать при unhealthy health-check
# AUTO_EXIT_ON_INVALID_TOKEN=true — завершать при невалидном токене
# AUTO_EXIT_ON_UNHEALTHY=false
# AUTO_EXIT_ON_INVALID_TOKEN=false

# Интервал проверки WebSocket и переинициализации при обрыве (мс, по умолчанию 120000)
# WS_HEALTH_CHECK_INTERVAL_MS=120000
# WS_CONNECT_TIMEOUT_MS=45000 — таймаут первого подключения WebSocket (мс)
# CRASH_LOG_PATH=logs/crash.log — отдельный лог всех сбоев и аварийных выходов
# LOG_DIR=logs

# Обязательные параметры
# Токен авторизации Twitch (можно получить из cookies браузера)
token=your_auth_token_here
# Список приоритетных стримеров через запятую
channelsWithPriority=alkaizerx,mathil1

# Параметры просмотра (в минутах) - только для puppeteer режима
minWatching=15
maxWatching=30

# Параметры скриншотов - только для puppeteer режима
browserScreenshot=false
screenshotInterval=0

# Параметры браузера (опционально) - только для puppeteer режима
# Путь к Chromium в Docker Alpine (обычно /usr/bin/chromium-browser или /usr/bin/chromium)
exec=/usr/bin/chromium-browser
# userAgent=Mozilla/5.0...
# timeout=30000

# Параметры прокси (если из контейнера Twitch недоступен, а с хоста curl.exe работает)
# proxy=host.docker.internal:8080
# proxyAuth=username:password

# Docker: user_id аккаунта (из curl validate на хосте), если из контейнера id.twitch.tv недоступен
# TWITCH_USER_ID=72911320

# Docker: ожидание DNS перед стартом (секунды), попытки validate при старте
# TWITCH_DNS_WAIT_MAX_SECONDS=90
# TWITCH_STARTUP_VALIDATE_ATTEMPTS=5
# TWITCH_STARTUP_VALIDATE_DELAY_MS=5000
# FETCH_TIMEOUT_MS=30000

# Client-Integrity для сбора бонусов (claim) и рейдов
# TWITCH_INTEGRITY_SOURCE=browser — Playwright/Chromium (по умолчанию); manual — из .env; api — только POST /integrity
# TWITCH_INTEGRITY_BROWSER=false — быстро выключить браузер → manual (если задан TWITCH_CLIENT_INTEGRITY) или api
# TWITCH_DEVICE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx — cookie unique_id (тот же, что в браузере)
# TWITCH_CLIENT_INTEGRITY=v4.public.... — токен из DevTools (режим manual или fallback при сбое browser)
# TWITCH_CLIENT_INTEGRITY_EXPIRES_MS=1730000000000 — unix ms истечения ручного токена (опционально)
# TWITCH_INTEGRITY_BROWSER_URL=https://www.twitch.tv — страница для загрузки Kasada
# TWITCH_INTEGRITY_BROWSER_WAIT_MS=5000 — пауза после загрузки страницы (мс)
# TWITCH_INTEGRITY_BROWSER_TIMEOUT_MS=90000 — таймаут запуска браузера и навигации (мс)
# exec=/usr/bin/chromium-browser — путь к Chromium на Termux (или PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH)
