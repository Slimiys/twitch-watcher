# Режим работы: api или puppeteer (по умолчанию puppeteer)
MODE=api

# Уровень логирования: verbose, normal, minimal (по умолчанию normal)
LOG_LEVEL=normal

# Максимальное количество одновременно просматриваемых каналов (только для API режима)
MAX_SIMULTANEOUS_CHANNELS=2

# Health Check настройки
HEALTH_CHECK_PORT=3000

# Web Server настройки
WEB_SERVER_PORT=3001

# Обязательные параметры
# Токен авторизации Twitch (можно получить из cookies браузера)
token=your_auth_token_here
# Список приоритетных стримеров через запятую
channelsWithPriority=alkaizerx,mathil1

# Параметры просмотра (в минутах) - только для puppeteer режима
minWatching=15
maxWatching=30

# Параметры скриншотов - только для puppeteer режима
browserScreenshot=false
screenshotInterval=0

# Параметры браузера (опционально) - только для puppeteer режима
# Путь к Chromium в Docker Alpine (обычно /usr/bin/chromium-browser или /usr/bin/chromium)
exec=/usr/bin/chromium-browser
# userAgent=Mozilla/5.0...
# timeout=30000

# Параметры прокси (опционально)
# proxy=127.0.0.1:8080
# proxyAuth=username:password
