{
  "token": "your_auth_token_here",
  "app": {
    "LOG_LEVEL": "normal",
    "WEB_SERVER_PORT": "3001",
    "HEALTH_CHECK_PORT": "3000",
    "TWITCH_INTEGRITY_SOURCE": "auto",
    "TWITCH_INTEGRITY_AUTO_REFRESH": "true",
    "TWITCH_DEVICE_ID": "",
    "TWITCH_COOKIES": "unique_id=…; api_token=…",
    "TWITCH_CLIENT_INTEGRITY": "",
    "WEB_DASHBOARD_API_KEY": ""
  },
  "streamers": [
    "example_streamer_1",
    "example_streamer_2"
  ],
  "retry": {
    "maxAttempts": 5,
    "initialDelayMs": 1000,
    "maxDelayMs": 30000,
    "multiplier": 2,
    "jitter": true,
    "circuitBreaker": {
      "failureThreshold": 5,
      "resetTimeoutMs": 30000,
      "halfOpenMaxAttempts": 1
    },
    "websocket": {
      "maxReconnectAttempts": 10,
      "initialDelayMs": 1000,
      "maxDelayMs": 60000
    }
  },
  "statistics": {
    "storagePath": "./statistics",
    "format": "json",
    "rotationDays": 30,
    "autoSave": true
  },
  "watch": {
    "cycleIntervalMs": 60000
  },
  "favoriteCategories": [
    {
      "id": "509658",
      "name": "Just Chatting",
      "boxArtUrl": "https://static-cdn.jtvnw.net/ttv-boxart/52x72/509658.jpg"
    }
  ]
}
